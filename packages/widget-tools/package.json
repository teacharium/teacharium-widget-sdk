{
  "name": "@teacharium/widget-tools",
  "version": "0.1.1",
  "description": "Build, preview and publish Teacharium widgets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "teacharium": "./bin/teacharium.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c harness/vite.config.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p harness/tsconfig.json",
    "test": "vitest run",
    "build:harness": "vite build -c harness/vite.config.ts"
  },
  "dependencies": {
    "@teacharium/widget": "workspace:*",
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@teacharium/player": "^0.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
